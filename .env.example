# SOCOLES Grader – Example environment file
# Copy to '.env' and adjust for your environment.
# This file is read by docker-compose and the app at runtime.

# CHANGE THIS 
POSTGRES_PASSWORD=change-me

# Comma-separated list of allowed origins for CORS.
# No spaces unless quoted. Examples:
#  - Local dev: http://localhost:3000,http://127.0.0.1:3000
#  - University deploy: https://socoles.cs.ru.nl/
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

###############################
# Frontend <-> Backend URLs
###############################
# Public URL the browser uses to reach the backend API.
# - Local dev: http://localhost:5000
# - Production (same domain via reverse proxy): e.g. https://socoles.cs.ru.nl/
#   (proxy /grade-queries to the backend)
NEXT_PUBLIC_SOCOLES_API_URL=http://localhost:5000

# Internal URL the Next.js server uses inside the Docker network
SOCOLES_INTERNAL_API_URL=http://backend:5000

###############################
# NextAuth (OIDC via Keycloak)
###############################
# Public base URL for Next.js 
NEXTAUTH_URL=https://socoles.cs.ru.nl
# Secret for encrypting session/JWT (generate a long random string)
NEXTAUTH_SECRET=change-me
# Keycloak OIDC settings
KEYCLOAK_ISSUER=http://keycloak:8080/realms/socoles
KEYCLOAK_CLIENT_ID=socoles-frontend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_LOGOUT_REDIRECT_URI=https://socoles.cs.ru.nl
# Allow Auth.js (next-auth v5) to trust non-matching hosts during local/dev or behind proxies
# Remove this in strict production setups and ensure NEXTAUTH_URL matches the public origin exactly
AUTH_TRUST_HOST=true


###############################
# Instructor self-provisioning
###############################
# Optional: Restrict who can create an instructor account by email domain.
# Comma-separated, no spaces unless quoted. Leave empty to allow any domain.
# INSTRUCTOR_ALLOWED_DOMAINS=ru.nl
# Required: A one-time signup code. must enter to create an instructor account.
# Set this to a secret value and share privately.
INSTRUCTOR_SIGNUP_CODE=change-me


###############################
# SMTP for invites
###############################
# Configure to send emails for invite links.
# If not set, the app will still generate/copy links, but won’t send emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=SOCOLES <no-reply@example.com>

###############################
# Invite links base URL
###############################
# Public origin to use when generating invite links. Required in production.
# If not set, the API attempts to use X-Forwarded-* headers or falls back to request origin.
# Examples:
# INVITE_BASE_URL=https://socoles.cs
INVITE_BASE_URL=

