# SOCOLES Grader – Example environment file
# Copy to '.env' and adjust for your environment.
# This file is read by docker-compose and the app at runtime.

# CHANGE THIS 
POSTGRES_PASSWORD=change-me

# Comma-separated list of allowed origins for CORS.
# No spaces unless quoted. Examples:
#  - Local dev: http://localhost:3000,http://127.0.0.1:3000
#  - Org deploy: https://socoles.theorg.cs
#  - University deploy: https://socoles.university.edu
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

###############################
# Frontend <-> Backend URLs
###############################
# Public URL the browser uses to reach the backend API.
# - Local dev: http://localhost:5000
# - Production (same domain via reverse proxy): e.g. https://socoles.theorg.cs
#   (proxy /grade-queries to the backend)
NEXT_PUBLIC_SOCOLES_API_URL=http://localhost:5000

# Internal URL the Next.js server uses inside the Docker network
SOCOLES_INTERNAL_API_URL=http://backend:5000


###############################
# SMTP for invites (underdevelopment)
###############################
# Configure if you want emails sent for invite links.
# If not set, the app will still generate/copy links, but won’t send emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=SOCOLES <no-reply@example.com>

